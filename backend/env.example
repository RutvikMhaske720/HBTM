# Copy this file to .env. Keep .env private and out of version control.
DATABASE_URL=sqlite:///./data/iabtm.db
# Set during the PostgreSQL/pgvector migration, then promote to DATABASE_URL.
SUPABASE_DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only. Never use a secret key in frontend code or commit it.
SUPABASE_SECRET_KEY=

# Live YouTube search
YOUTUBE_API_KEY=

# Live Spotify track discovery. Client credentials remain server-side.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=IN

# Pinterest Art Pins from one authorised board. Use an access token OR client
# credentials. Required scopes: boards:read,pins:read.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Web search for Editorial. Optional but strongly recommended: without a key
# the curator falls back to scraping, and general engines (DuckDuckGo, Mojeek)
# serve a captcha to automated traffic from most networks. Publisher search
# feeds still work keyless, but cover a fixed roster of sites.
# Set WEB_SEARCH_PROVIDER to "tavily" or "brave".
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# Reserved for a future embedding upgrade. The curator currently uses a local,
# fit-free embedder and needs no key.
OPENAI_API_KEY=

# --- Curation policy ---------------------------------------------------------
# Reject anything published longer ago than this. Books and artworks are exempt
# (recency is not a quality signal for them); videos, podcasts and articles are
# not. Lower it for a stricter "latest only" feed.
CURATION_MAX_AGE_DAYS=540
# Minimum profile-match score for a candidate to be kept, scaled per source in
# app/curation/pipeline.py. Raise for a stricter feed, lower for a fuller one.
CURATION_RELEVANCE_THRESHOLD=0.15
# Cosine similarity at which two items are treated as the same thing.
CURATION_DUPLICATE_THRESHOLD=0.78
# Set false to skip the link/preview reachability check (faster, riskier).
CURATION_VERIFY_LINKS=true

FRONTEND_ORIGIN=http://localhost:3000
