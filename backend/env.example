# Copy this file to .env. Keep .env private and out of version control.
DATABASE_URL=sqlite:///./data/iabtm.db

# Live YouTube search
YOUTUBE_API_KEY=

# Live Spotify track discovery. Client Credentials stay server-side.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ISO country code used to filter tracks available to your audience.
SPOTIFY_MARKET=IN

# Pinterest Art Pins from one authorised board. Use an access token OR client
# credentials. Required scopes: boards:read,pins:read.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Optional sources and AI enrichment
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=iabtm-curator/0.1
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
OPENAI_API_KEY=

FRONTEND_ORIGIN=http://localhost:3000
